---
import '../styles/global.css';
import { dataset } from '../data';
import { otherLang, ui } from '../lib/i18n';
import type { Lang } from '../lib/schema';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.tagline} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    {
      dataset.status === 'draft_unverified' && (
        <div class="border-b border-notice-edge bg-notice-bg px-4 py-2.5 text-center text-xs text-notice-ink">
          {t.draftBanner}
        </div>
      )
    }

    <header class="border-b border-edge">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4">
        <a href={`/${lang}/`} class="font-semibold tracking-tight">{t.siteName}</a>
        <nav class="flex items-center gap-4 text-sm">
          <a href={`/${lang}/methodologie/`} class="text-ink/55 hover:text-ink"
            >{t.methodology}</a
          >
          <a href={`/${other}/`} class="text-ink/55 hover:text-ink">{t.switchLang}</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-5 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-edge">
      <div class="mx-auto max-w-3xl px-5 py-8 text-xs leading-relaxed text-ink/45">
        <p>{t.privacy}</p>
        <p class="mt-2">
          {dataset.version} — {dataset.updatedAt}
        </p>
      </div>
    </footer>
  </body>
</html>
